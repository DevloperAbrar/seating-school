# Dependencies
node_modules/
client/node_modules/
server/node_modules/

# Environment variables
.env
.env.local
.env.*.local
server/.env
client/.env

# Build output
client/dist/
client/build/
server/dist/

# Uploads (user-generated files, don't commit real uploads)
server/uploads/*
!server/uploads/.gitkeep

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Prisma
server/prisma/*.db
server/prisma/migrations/dev.db

# OS files
.DS_Store
Thumbs.db

# Editor
.vscode/
.idea/
*.swp

# Misc
*.pem
.cache/